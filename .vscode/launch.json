{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎗️ Launch Streamlit Diagnostic App (F5)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/app.py",
        "--server.port=8501"
      ],
      "jinja": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "🧪 Run 5-Stage Verification Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_pipeline.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🏋️ Train VGG-16 Model (10 Epochs)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--epochs", "10"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "📄 Generate PDF Technical Report",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/generate_pdf_report.py",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

